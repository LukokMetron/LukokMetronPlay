<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:theme="@style/AppTheme" android:label="LukokMetron Player" android:allowBackup="true" android:supportsRtl="true">
        <service android:name=".PlayerService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".PlayerWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.lukokmetron.player.PLAY_PAUSE" />
                <action android:name="com.lukokmetron.player.NEXT" />
                <action android:name="com.lukokmetron.player.PREV" />
                <action android:name="com.lukokmetron.player.OPEN" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/player_widget_info" />
        </receiver>
    </application>
</manifest>

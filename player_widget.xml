<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="#101615">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LukokMetron" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nenhuma música" android:textColor="#B7C0BC" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="6dp">
        <Button android:id="@+id/widget_prev" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="⏮" android:textSize="17sp" />
        <Button android:id="@+id/widget_play" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="▶" android:textSize="17sp" />
        <Button android:id="@+id/widget_next" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="⏭" android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
